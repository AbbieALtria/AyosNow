{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": "python manage.py migrate && python manage.py check_deploy_env",
    "startCommand": "gunicorn ayosnow.wsgi:application --bind 0.0.0.0:$PORT --workers ${WEB_CONCURRENCY:-3}",
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
