DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=${{RAILWAY_PUBLIC_DOMAIN}}
RAILWAY_HEALTHCHECK_HOST=healthcheck.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://${{RAILWAY_PUBLIC_DOMAIN}}
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SECURE_PROXY_SSL_HEADER=true
DATABASE_URL=${{ayosnow-db.DATABASE_URL}}
AYOSNOW_DEFAULT_CURRENCY=PHP
AYOSNOW_COMMISSION_RATE=0.20
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
AYOSNOW_PAYMENT_GATEWAY_BACKEND=finance.gateways.PayMongoPaymentGateway
PAYMENT_GATEWAY_TIMEOUT_SECONDS=15
PAYMONGO_SECRET_KEY=sk_live_replace_me
PAYMONGO_WEBHOOK_SECRET=replace-with-paymongo-webhook-secret
PAYMONGO_CHECKOUT_URL=https://api.paymongo.com/v1/checkout_sessions
PAYMONGO_SUCCESS_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/app/
PAYMONGO_CANCEL_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/app/
AYOSNOW_SMS_BACKEND=accounts.sms.SemaphoreSmsBackend
SMS_TIMEOUT_SECONDS=15
SEMAPHORE_API_KEY=replace-with-semaphore-api-key
SEMAPHORE_SENDER_NAME=AyosNow
SEMAPHORE_MESSAGES_URL=https://api.semaphore.co/api/v4/messages
SEMAPHORE_OTP_TEMPLATE=Your AyosNow OTP is {code}. It expires soon.
AYOSNOW_OTP_EXPIRY_SECONDS=600
AYOSNOW_OTP_MAX_ATTEMPTS=5
AYOSNOW_OTP_RESEND_COOLDOWN_SECONDS=60
AYOSNOW_UPLOAD_MAX_BYTES=5242880
AYOSNOW_UPLOAD_URL_TTL_SECONDS=900
AYOSNOW_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf
